#!/usr/bin/env python3
"""permit: Claude Code PermissionRequest hook that can let the call pill answer the prompt.

Register (in ~/.claude/settings.json, see config/settings.example.json):
  "PermissionRequest": [{"matcher": "*", "hooks": [{"type": "command",
      "command": "$HOME/.claude/skills/gods/bin/permit", "timeout": 60}]}]

Where prompts show is `approvals.permission_prompts` in ~/.voicemode/call/config.json:
  - "app" (the default, also for a missing or invalid config): exit 0 at once, no output,
    stdin unread. Claude Code shows its own dialog exactly as without the hook.
  - "pill": only while a call is live (the call's session file is there and its ears are
    running) and CallPill runs. Write ~/.voicemode/call/permit/<id>.json and poll every
    0.2 s for <id>.answer ("allow" or "deny", written only by a physical click on the pill)
    for up to 50 s (PERMIT_TIMEOUT_S overrides). allow/deny prints the decision JSON;
    timeout prints nothing, so the in-app dialog takes over. Both files are always removed.
    A spoken heads-up says a prompt is waiting. No live call: the app's dialog, as above.
Voice never answers a prompt in either mode: the only writer of <id>.answer is the pill's
click handler. Any error: exit 0, no output.

    permit < payload.json     the hook
    permit --selftest         both modes against a temp folder, asserts what it prints
"""
import glob
import json
import os
import secrets
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CALL = os.environ.get("PERMIT_CALL_DIR") or os.path.join(HOME, ".voicemode", "call")
PERMIT_DIR = os.environ.get("PERMIT_DIR") or os.path.join(CALL, "permit")
CALL_BIN = os.path.join(HOME, ".claude", "skills", "gods", "bin", "call")


def prompt_mode():
    """approvals.permission_prompts from config.json: "pill" or "app" (the default)."""
    try:
        with open(os.path.join(CALL, "config.json")) as f:
            v = json.load(f).get("approvals", {}).get("permission_prompts")
        return "pill" if str(v).strip().lower() == "pill" else "app"
    except Exception:
        return "app"


def pill_running():
    if os.environ.get("PERMIT_ASSUME_PILL") in ("0", "1"):   # tests only
        return os.environ["PERMIT_ASSUME_PILL"] == "1"
    try:
        return subprocess.run(["pgrep", "-x", "CallPill"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=2).returncode == 0
    except Exception:
        return False


def clip(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def summarize(tool, inp):
    """(short, summary, mono): a few words for speech, the card text, monospaced or not."""
    inp = inp if isinstance(inp, dict) else {}
    if tool == "Bash":
        desc = str(inp.get("description") or "").strip()
        cmd = str(inp.get("command") or "").strip()
        return (desc or clip(cmd, 60) or "a shell command"), (desc + "\n" + cmd if desc else cmd), True
    if tool in ("Edit", "Write", "MultiEdit", "NotebookEdit", "Read"):
        p = str(inp.get("file_path") or inp.get("notebook_path") or "")
        verb = {"Write": "write", "Read": "read"}.get(tool, "edit")
        return "%s %s" % (verb, os.path.basename(p) or "a file"), p, True
    if tool in ("WebFetch",):
        return "fetch a web page", str(inp.get("url") or ""), True
    if tool in ("WebSearch",):
        return "search the web", str(inp.get("query") or ""), False
    if tool.startswith("mcp__"):
        parts = tool.split("__")
        name = parts[-1] if len(parts) >= 3 else tool
        server = parts[1] if len(parts) >= 3 else ""
        bits = []
        for k, v in inp.items():
            if isinstance(v, (dict, list)):
                v = json.dumps(v, ensure_ascii=False)
            bits.append("%s: %s" % (k, clip(v, 80)))
            if len(bits) >= 4:
                break
        head = "%s (%s)" % (name, server) if server else name
        return name.replace("_", " "), head + ("\n" + "\n".join(bits) if bits else ""), False
    return tool, clip(json.dumps(inp, ensure_ascii=False), 300), True


def session_title(sid):
    """The Claude app's title for this CLI session, from its index file. Cheap glob only."""
    if not sid or "/" in sid:
        return ""
    base = os.path.join(HOME, "Library", "Application Support", "Claude", "claude-code-sessions")
    for p in glob.glob(os.path.join(base, "*", "*", "local_" + sid + ".json")):
        try:
            with open(p) as f:
                m = json.load(f)
            if m.get("cliSessionId") == sid and m.get("title"):
                return str(m["title"])
        except Exception:
            pass
    return ""


def live_call():
    if not os.path.exists(os.path.join(CALL, "session")):
        return False
    try:
        with open(os.path.join(CALL, "ears.pid")) as f:
            os.kill(int(f.read().strip()), 0)
        return True
    except Exception:
        return False


def heads_up(short):
    try:
        subprocess.Popen([CALL_BIN, "say", "Permission needed: %s. Allow or deny on the pill." % clip(short, 80)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception:
        pass


def main():
    if prompt_mode() != "pill" or not live_call() or not pill_running():
        return None
    raw = sys.stdin.read()
    d = json.loads(raw) if raw.strip() else {}
    tool = str(d.get("tool_name") or "tool")
    short, summary, mono = summarize(tool, d.get("tool_input") or {})
    sid = str(d.get("session_id") or "")
    rid = secrets.token_hex(8)
    os.makedirs(PERMIT_DIR, exist_ok=True)
    req = os.path.join(PERMIT_DIR, rid + ".json")
    ans = os.path.join(PERMIT_DIR, rid + ".answer")

    def cleanup(*_):
        for p in (req, ans, req + ".tmp"):
            try:
                os.remove(p)
            except Exception:
                pass

    def on_signal(*_):
        cleanup()
        os._exit(0)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        try:
            signal.signal(s, on_signal)
        except Exception:
            pass
    try:
        rec = {
            "id": rid,
            "pid": os.getpid(),
            "session_id": sid,
            "title": session_title(sid),
            "tool_name": tool,
            "short": short,
            "summary": clip(summary, 2000) if not mono else summary[:2000],
            "mono": mono,
            "cwd": str(d.get("cwd") or ""),
            "permission_mode": str(d.get("permission_mode") or ""),
            "created": time.time(),
        }
        with open(req + ".tmp", "w") as f:
            json.dump(rec, f)
        os.replace(req + ".tmp", req)
        if os.environ.get("PERMIT_QUIET") != "1":
            heads_up(short)
        try:
            timeout = float(os.environ.get("PERMIT_TIMEOUT_S") or 50)
        except ValueError:
            timeout = 50.0
        end = time.time() + timeout
        while time.time() < end:
            try:
                with open(ans) as f:
                    a = f.read().strip().lower()
            except FileNotFoundError:
                a = ""
            if a in ("allow", "deny"):
                return a
            time.sleep(0.2)
        return None
    finally:
        cleanup()


def selftest():
    """Run this hook as Claude Code does, against a temp call folder. Never speaks
    (PERMIT_QUIET) and never asks the real CallPill (PERMIT_ASSUME_PILL)."""
    import shutil
    import tempfile
    import threading

    tmp = tempfile.mkdtemp(prefix="permit-test-")
    pdir = os.path.join(tmp, "permit")
    payload = json.dumps({"session_id": "s-test", "tool_name": "Bash", "cwd": "/tmp",
                          "hook_event_name": "PermissionRequest",
                          "tool_input": {"command": "npm run deploy", "description": "Deploy"}})
    fails = checks = 0
    # 300 ms on a Mac in use; shared CI runners are slower and noisier
    budget = 1500 if os.environ.get("CI") else 300

    def setup(config=None, live=False, pill=True):
        for name in ("config.json", "session", "ears.pid"):
            p = os.path.join(tmp, name)
            if os.path.isdir(p):
                os.rmdir(p)
            elif os.path.exists(p):
                os.remove(p)
        if config is not None:
            with open(os.path.join(tmp, "config.json"), "w") as f:
                f.write(config)
        if live:
            with open(os.path.join(tmp, "session"), "w") as f:
                f.write("s-call\n")
            with open(os.path.join(tmp, "ears.pid"), "w") as f:
                f.write(str(os.getpid()))  # a live process: this test
        return {**os.environ, "PERMIT_CALL_DIR": tmp, "PERMIT_DIR": pdir, "PERMIT_QUIET": "1",
                "PERMIT_ASSUME_PILL": "1" if pill else "0", "PERMIT_TIMEOUT_S": "3"}

    def run(env, answer=None):
        """(stdout, return code, ms, request seen). answer: what the pill click writes."""
        seen = []

        def click():
            end = time.time() + 2.5
            while time.time() < end:
                reqs = glob.glob(os.path.join(pdir, "*.json"))
                if reqs:
                    seen.append(json.load(open(reqs[0])))
                    with open(reqs[0][:-5] + ".answer", "w") as f:
                        f.write(answer)
                    return
                time.sleep(0.05)

        t = threading.Thread(target=click) if answer else None
        if t:
            t.start()
        t0 = time.time()
        p = subprocess.run([sys.executable, os.path.realpath(__file__)], input=payload,
                           capture_output=True, text=True, env=env, timeout=20)
        ms = (time.time() - t0) * 1000
        if t:
            t.join()
        return p.stdout.strip(), p.returncode, ms, seen

    def check(label, ok, detail=""):
        nonlocal fails, checks
        checks += 1
        fails += not ok
        print(f"{'PASS' if ok else 'FAIL'}  {label}" + (f"  [{detail}]" if detail and not ok else ""))

    def leftovers():
        return os.listdir(pdir) if os.path.isdir(pdir) else []

    # app mode (and anything that is not a valid "pill"): out of the way, at once
    for label, config, live in [("no config.json", None, True),
                                ("app", '{"approvals": {"permission_prompts": "app"}}', True),
                                ("not JSON", '{"approvals": ', True), ("a list", "[]", True),
                                ("unknown value", '{"approvals": {"permission_prompts": "x"}}', True),
                                ("approvals not an object", '{"approvals": "pill"}', True)]:
        out, rc, ms, _ = run(setup(config, live=live), answer=None)
        check(f"app mode ({label}): prints nothing, returns at once ({ms:.0f} ms, live call)",
              out == "" and rc == 0 and ms < budget and not leftovers(), f"{out!r} rc={rc}")
    # pill mode, but no live call: the app's dialog
    pill = '{"approvals": {"permission_prompts": "pill"}, "user_label": "USER"}'
    out, rc, ms, _ = run(setup(pill, live=False))
    check(f"pill mode, no call: prints nothing, returns at once ({ms:.0f} ms)",
          out == "" and rc == 0 and ms < budget and not leftovers(), f"{out!r}")
    env = setup(pill, live=True)
    os.remove(os.path.join(tmp, "ears.pid"))
    out, rc, ms, _ = run(env)
    check(f"pill mode, session file but no ears: at once ({ms:.0f} ms)",
          out == "" and rc == 0 and ms < budget and not leftovers(), f"{out!r}")
    out, rc, ms, _ = run(setup(pill, live=True, pill=False))
    check(f"pill mode, live call, CallPill not running: at once ({ms:.0f} ms)",
          out == "" and rc == 0 and ms < budget and not leftovers(), f"{out!r}")
    # pill mode during a live call: the pill's click answers
    for answer, behavior in (("allow", "allow"), ("deny", "deny")):
        out, rc, ms, seen = run(setup(pill, live=True), answer=answer)
        try:
            got = json.loads(out)["hookSpecificOutput"]["decision"]["behavior"]
        except Exception:
            got = None
        check(f"pill mode, live call: a click on {answer} answers ({ms:.0f} ms)",
              got == behavior and rc == 0 and not leftovers()
              and bool(seen) and seen[0].get("short") == "Deploy", f"{out!r} {seen[:1]}")
    out, rc, ms, _ = run(setup(' {"approvals": {"permission_prompts": " PILL "}} ', live=True),
                         answer="allow")
    check("pill mode: value read case-blind", '"allow"' in out, f"{out!r}")
    env = setup(pill, live=True)
    env["PERMIT_TIMEOUT_S"] = "0.5"
    out, rc, ms, _ = run(env)
    check(f"pill mode, live call, no click: prints nothing after the timeout ({ms:.0f} ms)",
          out == "" and rc == 0 and 450 < ms and not leftovers(), f"{out!r}")
    shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{checks - fails} passed, {fails} failed")
    return fails


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        raise SystemExit(1 if selftest() else 0)
    try:
        verdict = main()
    except Exception:
        verdict = None
    if verdict == "allow":
        out = {"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "allow"}}}
    elif verdict == "deny":
        out = {"hookSpecificOutput": {"hookEventName": "PermissionRequest",
                                      "decision": {"behavior": "deny", "message": "Denied from the call pill"}}}
    else:
        out = None
    if out is not None:
        try:
            sys.stdout.write(json.dumps(out) + "\n")
            sys.stdout.flush()
        except Exception:
            pass
    sys.exit(0)
